<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SeedlessApplication"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:isGame="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">

        <receiver
            android:name=".control.ReleaseCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <receiver
            android:name=".ra.RaHostOverrideReceiver"
            android:exported="true" />

        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.Seedless.Launcher"
            android:exported="true" />

        <activity-alias
            android:name="${applicationId}.DefaultIcon"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="${applicationId}.AltIcon"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_alt"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".emu.EmulatorActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar">
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\.nds" />
                <data android:pathPattern=".*\.NDS" />
                <data android:pathPattern=".*\.dsi" />
                <data android:pathPattern=".*\.DSI" />
                <data android:pathPattern=".*\.srl" />
                <data android:pathPattern=".*\.ids" />
            </intent-filter>
        </activity>

        <activity
            android:name=".emu.MultiplayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />

        <activity
            android:name=".emu.PhantomActivity"
            android:launchMode="singleTask"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|keyboard|uiMode"
            android:exported="false" />
        <service
            android:name=".emu.PhantomCoordinatorService"
            android:exported="false" />
        <service
            android:name=".emu.PhantomPrimaryService"
            android:process=":phantom_primary"
            android:exported="false" />
        <service
            android:name=".emu.PhantomPeerService"
            android:process=":phantom_peer"
            android:exported="false" />
        <activity
            android:name=".emu.PhantomPrimaryActivity"
            android:process=":phantom_primary"
            android:taskAffinity="${applicationId}.phantom_primary"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|keyboard|uiMode"
            android:exported="false" />
        <activity
            android:name=".emu.PhantomPeerActivity"
            android:process=":phantom_peer"
            android:taskAffinity="${applicationId}.phantom_peer"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|keyboard|uiMode"
            android:exported="false" />

        <activity-alias
            android:name="com.seedlessds.app.LaunchGame"
            android:targetActivity=".emu.EmulatorActivity"
            android:exported="true" />

    </application>
</manifest>
