<options>
filter=linear
</options>

<vertex>
attribute vec2 a_vertex_coordinate;
attribute vec2 a_texture_coordinate;
varying vec2 v_texture_coordinate;
void main() {
    gl_Position = vec4(a_vertex_coordinate, 0.0, 1.0);
    v_texture_coordinate = a_texture_coordinate;
}
</vertex>

<fragment>
varying vec2 v_texture_coordinate;
uniform sampler2D u_texture;

vec3 sharp(sampler2D tex, vec2 texCoord)
{
   vec2 p = texCoord.xy;
   p = p * u_texture_size.zw + vec2(0.5, 0.5);
   vec2 i = floor(p);
   vec2 f = p - i;
   f = f * f * f * (f * (f * 6.0 - vec2(15.0, 15.0)) + vec2(10.0, 10.0));
   p = i + f;
   p = (p - vec2(0.5, 0.5)) * u_texture_size.xy;
   return texture2D(tex, p).rgb;
}

void main() {
    gl_FragColor = vec4(sharp(u_texture, v_texture_coordinate), 1.0);
}
</fragment>
